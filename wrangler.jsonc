{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gofurry-lite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
