{
  "name": "gofurry-lite",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/index.html"],
      "fallthrough": true
    }
  ]
}
