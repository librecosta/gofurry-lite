{
  "name": "gofurry-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && next dev",
    "build": "node scripts/prepare.mjs && next build && node scripts/verify-export.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "node scripts/prepare.mjs && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "test": "node scripts/prepare.mjs && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:worker": "wrangler deploy --dry-run --outdir .local/v1/worker"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "sass": "1.108.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.165.0"
  }
}
